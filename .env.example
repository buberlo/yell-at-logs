# Optional environment variables for guilt-poet.
#
# Copy this file to `.env` and fill in the values you need, or export the
# variables in your shell. All variables are optional unless you want to
# post an apology comment to a GitHub issue.

# GitHub personal access token used to authenticate API requests.
# For classic tokens, the `repo` scope is enough for public repositories.
# For fine-grained tokens, grant "Issues: Read and write" on the target repo.
GITHUB_TOKEN=

# Target repository in `owner/repository` form.
# Example: GITHUB_REPOSITORY=acme/guilt-poet
GITHUB_REPOSITORY=

# Issue number that should receive the apologetic comment.
# Example: GITHUB_ISSUE_NUMBER=42
GITHUB_ISSUE_NUMBER=

# Optional guilt score threshold from 0 to 100.
# If the combined guilt score reaches this value, guilt-poet may post to GitHub.
GUILT_THRESHOLD=80